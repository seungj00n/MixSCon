{
  "epochs": 200,
  "patience": 30,
  "batch_size": 32,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "temperature_scl": 0.07,
  "temperature_proto": 0.07,
  "temperature_cls": 0.07,
  "beta": 1.0,
  "gamma": 1.0,
  "lambda_proto": 0.0,
  "lambda_align": 0.0,
  "w_same_patient": 1.0,
  "w_cross_patient": 1.8,
  "mix_kappa": 0.5,
  "mix_eps": 0.05,
  "prefer_cross_patient_for_mix": true,
  "prefer_same_class_for_mix": true,
  "backbone": "resnet50",
  "use_timm": false,
  "proj_dim": 128,
  "use_cosine_classifier": true,
  "use_align_loss": false,
  "two_views": true,
  "color_jitter": [
    0.2,
    0.2,
    0.2,
    0.05
  ],
  "gaussian_blur_p": 0.2,
  "hflip_p": 0.5,
  "vflip_p": 0.5,
  "rot90": true,
  "use_focal_loss": true,
  "focal_gamma": 2.0,
  "focal_alpha": 1.0,
  "num_workers": 4,
  "pin_memory": true,
  "min_delta": 0.0001,
  "proto_momentum": 0.99,
  "seed": 2025
}
